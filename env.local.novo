# Copie os valores reais do seu .env.local antigo para cá e depois renomeie este arquivo para .env.local
# Os valores reais NUNCA devem ser commitados.

# URL pública do site (Vercel)
NEXT_PUBLIC_SITE_URL=https://air-trips.vercel.app

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # chave publicável/anon, segura para o browser
SUPABASE_SERVICE_ROLE_KEY=              # chave service_role — NUNCA prefixar com NEXT_PUBLIC_

# Analytics
NEXT_PUBLIC_GA_ID=                      # Google Analytics → Admin → Fluxo de dados
NEXT_PUBLIC_META_PIXEL_ID=              # Meta Events Manager → Configurações do Pixel
